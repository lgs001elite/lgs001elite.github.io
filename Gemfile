# Only needed to preview the site on your own computer (GitHub Pages builds it by itself).
# The `github-pages` gem pins the same Jekyll and plugin versions GitHub uses.
#
#   bundle install
#   bundle exec jekyll serve --livereload   # then open http://localhost:4000
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"   # required by `jekyll serve` on Ruby 3+
